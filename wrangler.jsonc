{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oncopaper-radar",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-29",

  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["*"]
  },

  "ai": {
    "binding": "AI",
    "remote": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oncopaper-radar",
      "database_id": "01bf7eff-20a3-4202-a059-f19ee80f91a8"
    }
  ],

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },

  "triggers": {
    "crons": ["0 5 * * *"]
  }
}
